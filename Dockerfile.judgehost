FROM domjudge/judgehost:9.0.0

USER root

# Instalar Kotlin, Node.js y Go
RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip wget nodejs golang-go && \
    wget -q https://github.com/JetBrains/kotlin/releases/download/v1.9.25/kotlin-compiler-1.9.25.zip -O /tmp/kotlin.zip && \
    unzip -q /tmp/kotlin.zip -d /opt && \
    ln -s /opt/kotlinc/bin/kotlinc /usr/local/bin/kotlinc && \
    ln -s /opt/kotlinc/bin/kotlin /usr/local/bin/kotlin && \
    rm /tmp/kotlin.zip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Wrapper de start.sh: configura Kotlin en el chroot al arrancar
RUN mv /scripts/start.sh /scripts/start-original.sh && \
    printf '#!/bin/bash\n\
(\n\
  while [ ! -d /chroot/domjudge/usr/lib/jvm/java-21-openjdk-amd64/lib ]; do sleep 2; done\n\
  \n\
  # Copiar Kotlin a /usr/lib/kotlinc en el chroot (usr si se monta en el sandbox)\n\
  cp -r /opt/kotlinc /chroot/domjudge/usr/lib/kotlinc\n\
  \n\
  # Arreglar shebang: env no disponible en el sandbox de DOMjudge\n\
  sed -i "s|#!/usr/bin/env bash|#!/usr/bin/bash|g" /chroot/domjudge/usr/lib/kotlinc/bin/kotlinc\n\
  sed -i "s|#!/usr/bin/env bash|#!/usr/bin/bash|g" /chroot/domjudge/usr/lib/kotlinc/bin/kotlin\n\
  \n\
  # Symlinks en /usr/local/bin del chroot\n\
  mkdir -p /chroot/domjudge/usr/local/bin\n\
  ln -sf /usr/lib/kotlinc/bin/kotlinc /chroot/domjudge/usr/local/bin/kotlinc\n\
  ln -sf /usr/lib/kotlinc/bin/kotlin /chroot/domjudge/usr/local/bin/kotlin\n\
  \n\
  # Fix libjli.so: registrar Java en el linker del chroot\n\
  echo "/usr/lib/jvm/java-21-openjdk-amd64/lib" > /chroot/domjudge/etc/ld.so.conf.d/java.conf\n\
  chroot /chroot/domjudge ldconfig\n\
  \n\
  # Node.js: copiar binario y dependencias al chroot\n\
  cp /usr/bin/node /chroot/domjudge/usr/bin/node 2>/dev/null || true\n\
  cp /usr/bin/nodejs /chroot/domjudge/usr/bin/nodejs 2>/dev/null || true\n\
  \n\
  # Go: copiar binario al chroot\n\
  cp /usr/bin/go /chroot/domjudge/usr/bin/go 2>/dev/null || true\n\
  cp /usr/local/go/bin/go /chroot/domjudge/usr/bin/go 2>/dev/null || true\n\
) &\n\
exec /scripts/start-original.sh "$@"\n' > /scripts/start.sh && \
    chmod +x /scripts/start.sh
