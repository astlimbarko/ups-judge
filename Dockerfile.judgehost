FROM domjudge/judgehost:9.0.0

USER root

# Instalar Kotlin (requiere unzip + descarga del compilador oficial)
RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip wget && \
    wget -q https://github.com/JetBrains/kotlin/releases/download/v2.0.21/kotlin-compiler-2.0.21.zip -O /tmp/kotlin.zip && \
    unzip -q /tmp/kotlin.zip -d /opt && \
    ln -s /opt/kotlinc/bin/kotlinc /usr/local/bin/kotlinc && \
    ln -s /opt/kotlinc/bin/kotlin /usr/local/bin/kotlin && \
    rm /tmp/kotlin.zip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
